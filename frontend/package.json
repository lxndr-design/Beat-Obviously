{
  "name": "beat-frontend",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.12.0 <27",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "verify:daw": "node ../scripts/verify-daw-core.mjs",
    "verify:audio-bus": "node ../scripts/verify-audio-bus.mjs",
    "verify:documents": "node ../scripts/verify-document-roundtrip.mjs",
    "verify:instrument-repository": "node ../scripts/verify-instrument-song-repository.mjs",
    "verify:collaboration": "node ../scripts/verify-collaboration-foundation.mjs",
    "verify:midi-remix": "node ../scripts/verify-midi-remix.mjs",
    "verify:native-doc": "node ../scripts/verify-native-document-registration.mjs",
    "verify:native-toolchain": "node ../scripts/verify-native-toolchain.mjs",
    "verify:design-system": "node ../scripts/verify-design-system.mjs",
    "verify:version": "node ../scripts/verify-version.mjs",
    "verify:audio-boundary": "node ../scripts/verify-audio-boundary.mjs",
    "verify:sampler-zones": "node ../scripts/verify-sampler-zones.mjs",
    "verify:synth": "node ../scripts/verify-synth-roundtrip.mjs",
    "verify:aurum": "node ../scripts/verify-aurum.mjs",
    "verify:lumen": "node ../scripts/verify-lumen-foundation.mjs && node ../scripts/verify-lumen-v2-wavetable.mjs && node ../scripts/benchmark-lumen-aether-equivalence.mjs",
    "verify:lumen-vital": "node ../scripts/verify-lumen-vital-benchmark.mjs",
    "benchmark:lumen-aether": "node ../scripts/benchmark-lumen-aether-equivalence.mjs",
    "verify:feature-demo": "node ../scripts/create-lumen-aurum-demo.mjs /private/tmp/Test_song_1",
    "verify:original-songs": "node ../scripts/create-original-reference-songs.mjs /private/tmp/Beat_Original_Songs",
    "verify:benchmark-instruments": "node ../scripts/verify-aether-benchmark-renders.mjs",
    "verify:node-instrument": "node ../scripts/verify-node-instrument-editor.mjs",
    "verify:track-interactions": "node ../scripts/verify-track-interactions.mjs",
    "verify:drums": "node ../scripts/verify-drum-generation.mjs",
    "verify:audio-to-midi": "node ../scripts/verify-audio-to-midi.mjs",
    "verify:score-import": "node ../scripts/verify-score-import.mjs",
    "verify:interactions": "node ../scripts/verify-frontend-interactions.mjs && node ../scripts/verify-stable-control-rows.mjs && npm run verify:midi-remix",
    "verify:stable-controls": "node ../scripts/verify-stable-control-rows.mjs",
    "verify:ribbon-help": "node ../scripts/verify-ribbon-help.mjs",
    "verify:instrument-track-creation": "node --experimental-strip-types ../scripts/verify-instrument-track-creation.mjs",
    "verify:beta": "node ../scripts/verify-beta-readiness.mjs --scope=source",
    "verify:beta:all": "node ../scripts/verify-beta-readiness.mjs --scope=all",
    "package:beta": "../scripts/package-beta-release.sh",
    "verify:non-native": "npm run verify:version && npm run verify:design-system && npm run verify:audio-boundary && npm run verify:sampler-zones && npm run typecheck && npm run verify:synth && npm run verify:aurum && npm run verify:lumen && npm run verify:benchmark-instruments && npm run audit:generation && npm run verify:daw && npm run verify:documents && npm run verify:instrument-repository && npm run verify:track-interactions && npm run verify:interactions && npm run verify:node-instrument && npm run verify:drums && npm run build",
    "visualize:codebase": "node ../scripts/generate-codebase-visualizer.mjs",
    "generate:icons": "node ../scripts/generate-icon-subset.mjs",
    "audit:aether-presets": "node ../scripts/audit-aether-presets.mjs",
    "audit:dependencies": "node ../scripts/check-dependency-freshness.mjs",
    "benchmark:aether-serum": "node ../scripts/benchmark-aether-serum.mjs",
    "audit:generation": "node ../scripts/audit-generation-diversity.mjs",
    "benchmark:midi-stress": "node ../scripts/benchmark-dense-midi.mjs",
    "generate:dense-stress": "node ../scripts/create-dense-stress-projects.mjs",
    "benchmark:dense-operations": "node --expose-gc ../scripts/benchmark-dense-project-operations.mjs"
  },
  "dependencies": {
    "@iconify/core": "^4.1.1",
    "dexie": "^4.4.4",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "immer": "^10.1.1",
    "nanoid": "^5.1.16",
    "solid-js": "^1.9.14",
    "three": "^0.170.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@types/three": "^0.170.0",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-solid": "^2.11.14"
  }
}
