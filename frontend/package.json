{
  "name": "beat-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "verify:daw": "node ../scripts/verify-daw-core.mjs",
    "verify:documents": "node ../scripts/verify-document-roundtrip.mjs",
    "verify:native-doc": "node ../scripts/verify-native-document-registration.mjs",
    "verify:design-system": "node ../scripts/verify-design-system.mjs",
    "verify:synth": "node ../scripts/verify-synth-roundtrip.mjs",
    "verify:node-instrument": "node ../scripts/verify-node-instrument-editor.mjs",
    "verify:track-interactions": "node ../scripts/verify-track-interactions.mjs",
    "verify:drums": "node ../scripts/verify-drum-generation.mjs",
    "verify:interactions": "node ../scripts/verify-frontend-interactions.mjs",
    "benchmark:midi-stress": "node ../scripts/benchmark-dense-midi.mjs"
  },
  "dependencies": {
    "@iconify/core": "^4.1.0",
    "dexie": "^4.0.10",
    "immer": "^10.1.1",
    "nanoid": "^5.0.9",
    "solid-js": "^1.9.13",
    "three": "^0.170.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.2",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12"
  }
}
